# 环境变量示例 - 复制为 .env.local（开发）或 .env.production（生产）

# ============ 应用配置 ============
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_APP_URL=https://your-domain.com

# ============ 数据库配置 ============
# 本地开发
DATABASE_URL=postgresql://postgres:password@localhost:5432/dog_is_ok

# 阿里云 RDS（生产）
# DATABASE_URL=postgresql://postgres:Password123@rm-xxx.postgres.rds.aliyuncs.com:5432/dog_is_ok

# ============ Redis 缓存 ============
REDIS_URL=redis://:redis_password@localhost:6379
# 阿里云 Redis
# REDIS_URL=redis://:password@r-xxx.redis.rds.aliyuncs.com:6379

# ============ AI SDK 配置 ============
# 选择一个 AI 提供商，填入 API Key
OPENAI_API_KEY=sk-your-key-here
# 或
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ============ 阿里云 OSS 存储配置 ============
ALIYUN_OSS_REGION=oss-cn-hangzhou
ALIYUN_OSS_BUCKET=your-bucket-name
ALIYUN_OSS_ACCESS_KEY_ID=your-access-key-id
ALIYUN_OSS_ACCESS_KEY_SECRET=your-access-key-secret
# 文件上传 URL 前缀
NEXT_PUBLIC_OSS_URL=https://your-bucket-name.oss-cn-hangzhou.aliyuncs.com

# ============ Supabase 迁移中（可选，逐步移除） ============
# SUPABASE_URL=https://xxx.supabase.co
# SUPABASE_ANON_KEY=xxx

# ============ 监控和日志 ============
# 阿里云日志服务
ALIYUN_LOG_ENDPOINT=https://cn-hangzhou.log.aliyuncs.com
ALIYUN_LOG_PROJECT=dog-is-ok
ALIYUN_LOG_STORE=application-logs

# ============ 数据库备份（可选） ============
# 自动备份到 OSS
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # 每天凌晨 2 点

# ============ 性能优化 ============
# API 速率限制
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60000  # 毫秒

# 缓存配置
CACHE_TTL=3600  # 1 小时

# ============ 安全配置 ============
# CORS 域名白名单
NEXT_PUBLIC_CORS_ORIGIN=https://your-domain.com

# JWT 秘钥
JWT_SECRET=your-secure-jwt-secret-change-this

# ============ 邮件配置（可选） ============
SMTP_HOST=smtp.aliyun.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password

# ============ 第三方服务 ============
# Sentry 错误追踪
SENTRY_DSN=

# Google Analytics
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=

# ============ 开发工具（仅开发环境） ============
DEBUG=false
VERBOSE_LOGS=false
