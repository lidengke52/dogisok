# 环境变量示例 - 复制为 .env.local（开发）或 .env.production（生产）

# ============ 应用配置 ============
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_APP_URL=https://www.dogisok.net
NEXT_PUBLIC_SITE_URL=https://www.dogisok.net

# ============ 数据库配置 ============
# 本地开发 - PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/dog_is_ok

# 生产环境 - 当前使用 Supabase
# DATABASE_URL=postgresql://postgres:password@db.supabase.co:5432/postgres

# 迁移到阿里云 RDS 时使用
# DATABASE_URL=postgresql://postgres:Password123@rm-xxx.postgres.rds.aliyuncs.com:5432/dog_is_ok

# ============ 文件存储配置（关键：支持迁移） ============
# 当前使用 Vercel Blob
NEXT_PUBLIC_BLOB_URL=https://public.blob.vercel-storage.com

# 迁移到阿里云 OSS 时改为
# NEXT_PUBLIC_BLOB_URL=  # 保留为空
# NEXT_PUBLIC_OSS_URL=https://dogisok.oss-cn-hangzhou.aliyuncs.com

# 阿里云 OSS 凭证（迁移后需要）
# ALIYUN_OSS_REGION=oss-cn-hangzhou
# ALIYUN_OSS_BUCKET=dogisok
# ALIYUN_OSS_ACCESS_KEY_ID=your-access-key-id
# ALIYUN_OSS_ACCESS_KEY_SECRET=your-access-key-secret

# ============ Redis 缓存 ============
REDIS_URL=redis://:redis_password@localhost:6379
# 阿里云 Redis
# REDIS_URL=redis://:password@r-xxx.redis.rds.aliyuncs.com:6379

# ============ AI SDK 配置 ============
# 选择一个 AI 提供商，填入 API Key
OPENAI_API_KEY=sk-your-key-here
# 或
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ============ Supabase 配置（逐步迁移中） ============
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxx
SUPABASE_SERVICE_ROLE_KEY=xxx

# ============ 监控和日志 ============
# 阿里云日志服务（可选）
# ALIYUN_LOG_ENDPOINT=https://cn-hangzhou.log.aliyuncs.com
# ALIYUN_LOG_PROJECT=dog-is-ok
# ALIYUN_LOG_STORE=application-logs

# ============ 数据库备份（可选） ============
# 自动备份到 OSS
# BACKUP_ENABLED=true
# BACKUP_SCHEDULE=0 2 * * *  # 每天凌晨 2 点

# ============ 性能优化 ============
# API 速率限制
# RATE_LIMIT_REQUESTS=100
# RATE_LIMIT_WINDOW=60000  # 毫秒

# 缓存配置
# CACHE_TTL=3600  # 1 小时

# ============ 安全配置 ============
# CORS 域名白名单
NEXT_PUBLIC_CORS_ORIGIN=https://www.dogisok.net

# JWT 秘钥
JWT_SECRET=your-secure-jwt-secret-change-this

# ============ 邮件配置（可选） ============
# SMTP_HOST=smtp.aliyun.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASS=your-email-password

# ============ 第三方服务 ============
# Sentry 错误追踪
# SENTRY_DSN=

# Google Analytics
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=

# ============ 开发工具（仅开发环境） ============
DEBUG=false
VERBOSE_LOGS=false
